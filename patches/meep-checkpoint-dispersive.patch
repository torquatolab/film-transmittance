+/* --- DFT chunks -------------------------------------------------------------
+   A dft_chunk is threaded onto TWO different lists: next_in_dft chains the chunks of
+   one DFT *object* across fields chunks, and next_in_chunk chains every DFT chunk
+   belonging to one *fields* chunk.  fields::dump/load iterate fields chunks, so they
+   must walk next_in_chunk.  The shared save_dft_hdf5/load_dft_hdf5 in dft.cpp walk
+   next_in_dft -- correct for their own caller (dft_flux::save_hdf5, which passes one
+   object's list) but wrong here: starting from fields_chunk::dft_chunks and following
+   next_in_dft leaves that fields chunk's *other* monitors untouched.  For an ordinary
+   flux monitor that saved E but not H, so the restored flux was identically zero
+   while the file looked populated.  These two helpers are the same routines walking
+   the correct link, and they store full precision to match the field arrays. */
+/* Seven size_t per dft_chunk: component, N, nfreq, then two 32-bit halves each of the
+   frequency signature and the geometry/update signature. */
+#define DFT_DESC_STRIDE 7
+
+/* Content signature of one dft_chunk: what the monitor IS and how it accumulates.
+   Unlike a susceptibility's counter id this is derived from the monitor's own
+   definition, so it distinguishes two monitors that merely hold the same number of
+   values.  Written as five size_t per chunk, in the same order as the data.
+
+   Two traps this code exists to avoid, both hit during development:
+     - h5file stores these size_t arrays through a floating-point dataset, so only
+       values below 2^53 survive exactly; each signature is therefore stored as two
+       32-bit halves (see split_sig), split only at the very END, never during mixing.
+     - Masking during mixing would make the result depend only on the low bits of each
+       input.  For an IEEE-754 double that is the mantissa, so w and 2*w -- same
+       mantissa, different exponent -- would collide. */
+/* The signature is stored as TWO words of 32 bits rather than one narrowed word.
+   Each half is <= 2^32-1, so it fits a size_t on a 32-bit target and is exact in the
+   binary64 dataset h5file writes these through -- and the full 64 bits of hash are
+   kept, instead of the 2^-31 collision bound a single narrowed word would impose. */
+static void split_sig(uint64_t h, std::vector<size_t> &out) {
+  out.push_back((size_t)(h & 0xFFFFFFFFULL));
+  out.push_back((size_t)((h >> 32) & 0xFFFFFFFFULL));
+}
+
+static uint64_t mix64(uint64_t h, uint64_t v) {
+  h ^= v;
+  h *= 0xff51afd7ed558ccdULL;
+  h ^= h >> 33;
+  h *= 0xc4ceb9fe1a85ec53ULL;
+  h ^= h >> 33;
+  return h;
+}
+
+static uint64_t mix_double(uint64_t h, double d) {
+  static_assert(sizeof(double) == sizeof(uint64_t), "unexpected double width");
+  uint64_t bits;
+  memcpy(&bits, &d, sizeof(bits));
+  return mix64(h, bits);
+}
+
+static uint64_t dft_chunk_omega_sig(const dft_chunk *cur) {
+  uint64_t h = 0xcbf29ce484222325ULL;
+  for (size_t k = 0; k < cur->omega.size(); ++k)
+    h = mix_double(h, cur->omega[k]);
+  return h;
+}
+
+/* Geometry AND update semantics: two monitors with the same bounds and frequencies
+   still accumulate differently if their decimation, weights or volume factors differ,
+   and restoring one into the other would mix samples taken under different rules.
+
+   These hash exact double bit patterns, including `scale`, which is recomputed from
+   the symmetry/Bloch phase and the timestep.  That is deterministic for the same
+   build and inputs -- the supported case -- but a checkpoint is not guaranteed
+   portable across compilers or libm versions, where a final-bit difference in the
+   recomputed phase would be reported as a monitor mismatch. */
+static uint64_t dft_chunk_geom_sig(const dft_chunk *cur) {
+  uint64_t h = 0x100000001b3ULL;
+  h = mix64(h, (uint64_t)cur->is.dim);
+  /* ivec/vec store five slots but only the directions of their own `dim` are
+     meaningful; loop over those. */
+  LOOP_OVER_DIRECTIONS(cur->is.dim, d) {
+    h = mix64(h, (uint64_t)(int64_t)cur->is.in_direction(d));
+    h = mix64(h, (uint64_t)(int64_t)cur->ie.in_direction(d));
+    h = mix_double(h, cur->s0.in_direction(d));
+    h = mix_double(h, cur->s1.in_direction(d));
+    h = mix_double(h, cur->e0.in_direction(d));
+    h = mix_double(h, cur->e1.in_direction(d));
+    h = mix64(h, (uint64_t)(int64_t)cur->shift.in_direction(d));
+  }
+  h = mix_double(h, cur->dV0);
+  h = mix_double(h, cur->dV1);
+  h = mix64(h, (uint64_t)(int64_t)cur->get_decimation_factor());
+  h = mix64(h, (uint64_t)(cur->include_dV_and_interp_weights ? 1 : 0));
+  h = mix64(h, (uint64_t)(cur->sqrt_dV_and_interp_weights ? 1 : 0));
+  h = mix_double(h, cur->stored_weight.real());
+  h = mix_double(h, cur->stored_weight.imag());
+  h = mix_double(h, cur->extra_weight.real());
+  h = mix_double(h, cur->extra_weight.imag());
+  h = mix64(h, (uint64_t)(int64_t)cur->sn);
+  h = mix64(h, (uint64_t)(int64_t)cur->vc);
+  /* update_dft() multiplies by `scale` (which folds in stored_weight, the timestep,
+     and the symmetry/shift phase) and interpolates using avg1/avg2.  Two monitors
+     identical in geometry but built under a different Courant number or symmetry
+     phase accumulate on a different basis, so these must be part of the identity. */
+  h = mix_double(h, cur->scale.real());
+  h = mix_double(h, cur->scale.imag());
+  h = mix64(h, (uint64_t)(int64_t)cur->avg1);
+  h = mix64(h, (uint64_t)(int64_t)cur->avg2);
+  return h;
+}
+
+static void chunk_dft_desc(dft_chunk *dft_chunks, std::vector<size_t> &out) {
+  for (dft_chunk *cur = dft_chunks; cur; cur = cur->next_in_chunk) {
+    out.push_back((size_t)cur->c);
+    out.push_back(cur->N);
+    out.push_back(cur->omega.size());
+    split_sig(dft_chunk_omega_sig(cur), out);
+    split_sig(dft_chunk_geom_sig(cur), out);
+  }
+}
+
+static size_t chunk_dft_ntotal(dft_chunk *dft_chunks, size_t *my_start,
+                               bool single_parallel_file) {
+  size_t n = 0;
+  for (dft_chunk *cur = dft_chunks; cur; cur = cur->next_in_chunk)
+    n += cur->N * cur->omega.size() * 2;
+  if (single_parallel_file) {
+    *my_start = partial_sum_to_all(n) - n;
+    return sum_to_all(n);
+  }
+  *my_start = 0;
+  return n;
+}
+
+static void save_dft_chunk_list(dft_chunk *dft_chunks, const char *name, h5file *file,
+                                bool single_parallel_file) {
+  size_t istart;
+  size_t n = chunk_dft_ntotal(dft_chunks, &istart, single_parallel_file);
+  char dataname[1024];
+  snprintf(dataname, 1024, "%s_dft", name);
+  file->create_data(dataname, 1, &n, false /* append_data */, false /* single_precision */);
+  for (dft_chunk *cur = dft_chunks; cur; cur = cur->next_in_chunk) {
+    size_t Nchunk = cur->N * cur->omega.size() * 2;
+    file->write_chunk(1, &istart, &Nchunk, (realnum *)cur->dft);
+    istart += Nchunk;
+  }
+  file->done_writing_chunks();
+
+  std::vector<size_t> desc;
+  chunk_dft_desc(dft_chunks, desc);
+  size_t my_nd = desc.size(), d_start = 0, d_total = my_nd;
+  if (single_parallel_file) {
+    d_start = partial_sum_to_all(my_nd) - my_nd;
+    d_total = sum_to_all(my_nd);
+  }
+  char descname[1024];
+  snprintf(descname, 1024, "%s_dftdesc", name);
+  file->create_data(descname, 1, &d_total, false /* append_data */,
+                    false /* single_precision */);
+  if (my_nd) file->write_chunk(1, &d_start, &my_nd, desc.data());
+}
+
+static void load_dft_chunk_list(dft_chunk *dft_chunks, const char *name, h5file *file,
+                                bool single_parallel_file) {
+  size_t istart;
+  size_t n = chunk_dft_ntotal(dft_chunks, &istart, single_parallel_file);
+  char dataname[1024], descname[1024];
+  snprintf(dataname, 1024, "%s_dft", name);
+  snprintf(descname, 1024, "%s_dftdesc", name);
+  int file_rank;
+  size_t file_dims;
+
+  /* Identity check FIRST, and completely.  h5file keeps a notion of the "current"
+     dataset that read_size selects and read_chunk then reads from, so the descriptor
+     must be finished with before the data's read_size runs -- interleaving them sends
+     the bulk reads to the descriptor dataset instead. */
+  std::vector<size_t> want;
+  chunk_dft_desc(dft_chunks, want);
+  size_t my_nd = want.size(), d_start = 0, d_total = my_nd;
+  if (single_parallel_file) {
+    d_start = partial_sum_to_all(my_nd) - my_nd;
+    d_total = sum_to_all(my_nd);
+  }
+  /* No DFT monitors at all: nothing to identify, and an old checkpoint of a
+     monitor-free run has no descriptor to find.  d_total is a collective total, so
+     every rank takes this branch together. */
+  if (d_total == 0) {
+    file->read_size(dataname, &file_rank, &file_dims, 1);
+    if (file_rank != 1 || file_dims != n)
+      meep::abort("incorrect dataset size (%zu vs. %zu) in fields::load %s:%s", file_dims, n,
+                  file->file_name(), dataname);
+    return;
+  }
+  if (!file->dataset_exists(descname))
+    meep::abort("%s has no '%s': it predates the DFT checkpoint fix, and its DFT data is "
+                "incomplete (only one component per monitor was ever written). Re-dump it.",
+                file->file_name(), descname);
+  file->read_size(descname, &file_rank, &file_dims, 1);
+  if (file_rank != 1 || file_dims != d_total)
+    meep::abort("DFT descriptor size mismatch (%zu vs. %zu) in fields::load %s:%s", file_dims,
+                d_total, file->file_name(), descname);
+  if (my_nd) {
+    std::vector<size_t> have(my_nd);
+    file->read_chunk(1, &d_start, &my_nd, have.data());
+    for (size_t k = 0; k < my_nd; k += DFT_DESC_STRIDE) {
+      bool same = true;
+      for (size_t j = 0; j < DFT_DESC_STRIDE; ++j)
+        if (have[k + j] != want[k + j]) same = false;
+      if (!same)
+        meep::abort("DFT monitor %zu does not match the checkpoint in fields::load: file has "
+                    "{component %zu, N %zu, %zu freqs}, simulation has "
+                    "{component %zu, N %zu, %zu freqs} (frequencies or extent may also "
+                    "differ). Recreate the DFT monitors exactly as they were when dumped.",
+                    k / DFT_DESC_STRIDE, have[k], have[k + 1], have[k + 2], want[k], want[k + 1],
+                    want[k + 2]);
+    }
+  }
+
+  /* now select the data set and read it */
+  file->read_size(dataname, &file_rank, &file_dims, 1);
+  if (file_rank != 1 || file_dims != n)
+    meep::abort("incorrect dataset size (%zu vs. %zu) in fields::load %s:%s", file_dims, n,
+                file->file_name(), dataname);
+  for (dft_chunk *cur = dft_chunks; cur; cur = cur->next_in_chunk) {
+    size_t Nchunk = cur->N * cur->omega.size() * 2;
+    file->read_chunk(1, &istart, &Nchunk, (realnum *)cur->dft);
+    istart += Nchunk;
+  }
+}
