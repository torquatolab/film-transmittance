+/* fields_chunk::update_pols allocates the internal polarization data lazily, on
+   the first timestep.  A checkpoint can be written or read before that has
+   happened, so force the allocation here; init_internal_data zeroes it, which is
+   exactly the t=0 state.  Doing this symmetrically in dump and load keeps the
+   two sides agreeing on what is in the file.  Returns true if it allocated. */
+static bool alloc_pol_data(fields_chunk *fc) {
+  bool allocated = false;
+  FOR_FIELD_TYPES(ft) {
+    for (polarization_state *p = fc->pol[ft]; p; p = p->next) {
+      if (!p->data) {
+        p->data = p->s->new_internal_data(fc->f, fc->gv);
+        if (p->data) {
+          p->s->init_internal_data(fc->f, fc->dt, fc->gv, p->data);
+          allocated = true;
+        }
+      }
+    }
+  }
+  return allocated;
+}
+
+/* Total number of realnums of internal polarization (ADE auxiliary-field) state
+   held by one chunk.  Iteration order -- field type, then the pol linked list --
+   is the order in which fields_chunk builds pol[] from structure_chunk::chiP, so
+   it is reproduced exactly when the same structure is loaded back. */
+static size_t chunk_pol_ntot(fields_chunk *fc) {
+  size_t n = 0;
+  FOR_FIELD_TYPES(ft) {
+    for (polarization_state *p = fc->pol[ft]; p; p = p->next) {
+      if (p->data) n += p->s->num_internal_data(p->data);
+    }
+  }
+  return n;
+}
+
+/* Per-pole descriptor: two size_t per polarization, in the same iteration order as the
+   data itself -- {global chunk index, block length}.  This pins the per-pole
+   boundaries, which a per-chunk total does not: it catches a pole list whose blocks
+   are laid out differently, e.g. a gyrotropic pole (6*ntot) where a Lorentzian one
+   (2*ntot) was dumped.
+
+   It deliberately does NOT carry susceptibility::get_id(): that is a static counter
+   assigned at construction, so two poles built in swapped order receive the same ids
+   positionally and the check would pass anyway -- while a legitimate fields-only load
+   onto an independently rebuilt structure would get *different* ids and abort
+   spuriously.  Identity would need a content-derived fingerprint of the pole's
+   parameters, which the const susceptibility interface cannot currently supply.
+   Consequence, stated plainly: reordering two poles of EQUAL block size is not
+   detected.  Loading the structure from the same checkpoint (the supported flow)
+   makes that unreachable, since the pole list is then reconstructed from the file. */
+static void chunk_pol_desc(fields_chunk *fc, int chunk_index, std::vector<size_t> &out) {
+  FOR_FIELD_TYPES(ft) {
+    for (polarization_state *p = fc->pol[ft]; p; p = p->next) {
+      if (!p->data) continue;
+      size_t n = p->s->num_internal_data(p->data);
+      if (!n) continue;
+      out.push_back((size_t)chunk_index);
+      out.push_back(n);
+    }
+  }
+}
+
+/* Refuse unsupported materials BEFORE any file is opened or any field is restored.
+   Checking here rather than at the first num_internal_data() call matters: dump
+   truncates the target file and writes t and the field arrays before it reaches the
+   polarization pass, so a late abort would destroy a previously good checkpoint.
+   Collective: every process evaluates the same or_to_all, then all abort together. */
+void fields::assert_checkpointable() {
+  bool bad = false;
+  for (int i = 0; i < num_chunks; i++) {
+    if (!chunks[i]->is_mine()) continue;
+    FOR_FIELD_TYPES(ft) {
+      for (polarization_state *p = chunks[i]->pol[ft]; p; p = p->next)
+        if (p->s && !p->s->supports_checkpoint()) bad = true;
+    }
+  }
+  if (or_to_all(bad))
+    meep::abort("this simulation contains a susceptibility whose state cannot be "
+                "checkpointed (e.g. noisy_lorentzian_susceptibility, whose MT19937 "
+                "noise state lives outside the polarization data); refusing before "
+                "touching any file");
+}
+
+void fields::dump_polarizations(h5file *h5f, bool single_parallel_file) {
+  bool allocated = false;
+  for (int i = 0; i < num_chunks; i++) {
+    if (chunks[i]->is_mine()) allocated = alloc_pol_data(chunks[i]) || allocated;
+  }
+  // allocating P adds chunk-boundary communications for it (cf. fields::update_pols)
+  if (or_to_all(allocated)) chunk_connections_valid = false;
+
+  int my_num_chunks = 0;
+  for (int i = 0; i < num_chunks; i++) {
+    my_num_chunks += (single_parallel_file || chunks[i]->is_mine());
+  }
+
+  std::vector<size_t> num_p_(my_num_chunks, 0);
+  size_t my_ntot = 0;
+  for (int i = 0, chunk_i = 0; i < num_chunks; i++) {
+    if (chunks[i]->is_mine()) {
+      num_p_[chunk_i] = chunk_pol_ntot(chunks[i]);
+      my_ntot += num_p_[chunk_i];
+    }
+    chunk_i += (chunks[i]->is_mine() || single_parallel_file);
+  }
+
+  std::vector<size_t> num_p;
+  if (single_parallel_file) {
+    num_p.resize(my_num_chunks);
+    sum_to_master(num_p_.data(), num_p.data(), my_num_chunks);
+  }
+  else { num_p = std::move(num_p_); }
+
+  /* determine total dataset size and offset of this process's data */
+  size_t my_start = 0;
+  size_t ntotal = my_ntot;
+  if (single_parallel_file) {
+    my_start = partial_sum_to_all(my_ntot) - my_ntot;
+    ntotal = sum_to_all(my_ntot);
+  }
+
+  /* non-dispersive simulation: write nothing, so the file is unchanged */
+  if (ntotal == 0) return;
+
+  size_t dims[1] = {(size_t)my_num_chunks};
+  size_t start[1] = {0};
+  // full precision: a per-chunk block length exceeds float32's exact range (2^24)
+  // for a large 3D chunk, and would then be silently rounded.
+  h5f->create_data("num_pol", 1, dims, false /* append_data */, false /* single_precision */);
+  if (am_master() || !single_parallel_file) { h5f->write_chunk(1, start, dims, num_p.data()); }
+
+  /* descriptor table, laid out exactly like the data below */
+  std::vector<size_t> desc;
+  for (int i = 0; i < num_chunks; i++)
+    if (chunks[i]->is_mine()) chunk_pol_desc(chunks[i], i, desc);
+  size_t my_ndesc = desc.size();
+  size_t desc_start = 0;
+  size_t desc_total = my_ndesc;
+  if (single_parallel_file) {
+    desc_start = partial_sum_to_all(my_ndesc) - my_ndesc;
+    desc_total = sum_to_all(my_ndesc);
+  }
+  h5f->create_data("pol_desc", 1, &desc_total, false /* append_data */,
+                   false /* single_precision */);
+  if (my_ndesc) h5f->write_chunk(1, &desc_start, &my_ndesc, desc.data());
+
+  h5f->create_data("pol", 1, &ntotal, false /* append_data */, false /* single_precision */);
+  for (int i = 0; i < num_chunks; i++) {
+    if (chunks[i]->is_mine()) {
+      FOR_FIELD_TYPES(ft) {
+        for (polarization_state *p = chunks[i]->pol[ft]; p; p = p->next) {
+          if (!p->data) continue;
+          size_t n = p->s->num_internal_data(p->data);
+          if (n) {
+            h5f->write_chunk(1, &my_start, &n, p->s->internal_data_ptr(p->data));
+            my_start += n;
+          }
+        }
+      }
+    }
+  }
+}
+
+void fields::load_polarizations(h5file *h5f, bool single_parallel_file) {
+  bool allocated = false;
+  for (int i = 0; i < num_chunks; i++) {
+    if (chunks[i]->is_mine()) allocated = alloc_pol_data(chunks[i]) || allocated;
+  }
+  // allocating P adds chunk-boundary communications for it (cf. fields::update_pols)
+  if (or_to_all(allocated)) chunk_connections_valid = false;
+
+  int my_num_chunks = 0;
+  for (int i = 0; i < num_chunks; i++) {
+    my_num_chunks += (single_parallel_file || chunks[i]->is_mine());
+  }
+
+  /* The polarization data blocks are already allocated (fields_chunk built them
+     from the structure that was loaded first), so their sizes are known locally
+     and only have to be checked against the file. */
+  std::vector<size_t> expect(my_num_chunks, 0);
+  size_t my_ntot = 0;
+  for (int i = 0, chunk_i = 0; i < num_chunks; i++) {
+    if (chunks[i]->is_mine()) {
+      expect[chunk_i] = chunk_pol_ntot(chunks[i]);
+      my_ntot += expect[chunk_i];
+    }
+    chunk_i += (chunks[i]->is_mine() || single_parallel_file);
+  }
+
+  size_t my_start = 0;
+  size_t ntotal = my_ntot;
+  if (single_parallel_file) {
+    my_start = partial_sum_to_all(my_ntot) - my_ntot;
+    ntotal = sum_to_all(my_ntot);
+  }
+  if (ntotal == 0) return;
+
+  int rank;
+  size_t dims[1], start[1] = {0};
+  std::vector<size_t> num_p(my_num_chunks);
+  h5f->read_size("num_pol", &rank, dims, 1);
+  if (rank != 1 || dims[0] != (size_t)my_num_chunks)
+    meep::abort("chunk mismatch for 'num_pol' in fields::load");
+  if (am_master() || !single_parallel_file) h5f->read_chunk(1, start, dims, num_p.data());
+  if (single_parallel_file) {
+    h5f->prevent_deadlock();
+    broadcast(0, num_p.data(), dims[0]);
+  }
+  for (int i = 0, chunk_i = 0; i < num_chunks; i++) {
+    if (chunks[i]->is_mine() && num_p[chunk_i] != expect[chunk_i])
+      meep::abort("polarization size mismatch %zd vs %zd in fields::load", num_p[chunk_i],
+                  expect[chunk_i]);
+    chunk_i += (chunks[i]->is_mine() || single_parallel_file);
+  }
+
+  /* per-pole boundary check before any data is read: the descriptor pins each pole's
+     chunk and block length, so a pole list whose blocks are laid out differently
+     aborts instead of silently inheriting another pole's history.  It carries no
+     susceptibility id -- see chunk_pol_desc for why, and for what this does not
+     catch. */
+  std::vector<size_t> expect_desc;
+  for (int i = 0; i < num_chunks; i++)
+    if (chunks[i]->is_mine()) chunk_pol_desc(chunks[i], i, expect_desc);
+  size_t my_ndesc = expect_desc.size();
+  size_t desc_start = 0;
+  size_t desc_total = my_ndesc;
+  if (single_parallel_file) {
+    desc_start = partial_sum_to_all(my_ndesc) - my_ndesc;
+    desc_total = sum_to_all(my_ndesc);
+  }
+  h5f->read_size("pol_desc", &rank, dims, 1);
+  if (rank != 1 || dims[0] != desc_total)
+    meep::abort("polarization descriptor size mismatch %zu vs %zu in fields::load", dims[0],
+                desc_total);
+  if (my_ndesc) {
+    std::vector<size_t> file_desc(my_ndesc);
+    h5f->read_chunk(1, &desc_start, &my_ndesc, file_desc.data());
+    for (size_t k = 0; k < my_ndesc; k += 2) {
+      if (file_desc[k] != expect_desc[k] || file_desc[k + 1] != expect_desc[k + 1])
+        meep::abort("polarization %zu mismatch in fields::load: file has "
+                    "{chunk %zu, %zu values}, simulation has {chunk %zu, %zu values}",
+                    k / 2, file_desc[k], file_desc[k + 1], expect_desc[k], expect_desc[k + 1]);
+    }
+  }
+
+  h5f->read_size("pol", &rank, dims, 1);
+  if (rank != 1 || dims[0] != ntotal) {
+    meep::abort("inconsistent data size for 'pol' in fields::load (rank, dims[0]): "
+                "(%d, %zu) != (1, %zu)",
+                rank, dims[0], ntotal);
+  }
+  for (int i = 0; i < num_chunks; i++) {
+    if (chunks[i]->is_mine()) {
+      FOR_FIELD_TYPES(ft) {
+        for (polarization_state *p = chunks[i]->pol[ft]; p; p = p->next) {
+          if (!p->data) continue;
+          size_t n = p->s->num_internal_data(p->data);
+          if (n) {
+            h5f->read_chunk(1, &my_start, &n, p->s->internal_data_ptr(p->data));
+            my_start += n;
+          }
+        }
+      }
+    }
+  }
+}
